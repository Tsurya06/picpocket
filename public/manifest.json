{
  "name": "PicPocket — Free Encrypted Photo Vault & Gallery",
  "short_name": "PicPocket",
  "description": "Free, unlimited, private Google Photos alternative backed by your own Telegram channels. Client-side AES-256-GCM encrypted vault with WhatsApp backup sync.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0f1115",
  "background_color": "#0f1115",
  "categories": ["photo", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "og-image.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "PicPocket Desktop & Web Gallery"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "media",
          "accept": [
            "application/zip",
            "application/x-zip-compressed",
            "application/octet-stream",
            "application/pdf",
            "image/*",
            "video/*",
            "audio/*"
          ]
        }
      ]
    }
  }
}
